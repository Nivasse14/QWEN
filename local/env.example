# Copy to .env.local on the trusted computer that runs runpodctl, never on the
# RunPod Pod. Never put an API key or token in this file or in the repository.
# Store a new key with ./local/store-runpod-key.sh on that trusted computer.
# start-pod.sh and stop-pod.sh load it without printing it.

RUNPOD_STORAGE_MODE=network-volume
# Initial Pod to adopt. After a redeploy, .local-state/current-pod-id takes
# precedence so this old identifier cannot override the newly created Pod.
RUNPOD_POD_ID=ew6jja07rnn0cg
RUNPOD_POD_NAME=QWEN-ai-phone-stack
RUNPOD_TEMPLATE_ID=runpod-torch-v280
RUNPOD_NETWORK_VOLUME_ID=n10j3zet9z
RUNPOD_GPU_ID="NVIDIA GeForce RTX 4090"
RUNPOD_GPU_FALLBACK_ID="NVIDIA GeForce RTX 3090"
RUNPOD_DATA_CENTER_IDS=EU-RO-1
RUNPOD_PORTS=22/tcp

# Keep empty on the first redeploy: the official template's default command
# preserves Jupyter/SSH rescue access while private secrets are re-injected.
# Never place a key or token in Docker arguments.
RUNPOD_DOCKER_ARGS=

# Only for the cheaper Community Cloud / Pod-volume alternative:
# RUNPOD_STORAGE_MODE=pod-volume
# RUNPOD_POD_VOLUME_GB=300
# RUNPOD_CLOUD_TYPE=COMMUNITY
# RUNPOD_PUBLIC_IP=1
