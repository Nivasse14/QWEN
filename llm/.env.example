# Copier vers .env. Ne jamais inscrire HF_TOKEN ni une clé API dans ce fichier.

LLAMA_CPP_SOURCE=/workspace/llama.cpp
LLAMA_SERVER_BIN=/workspace/llama.cpp/build/bin/llama-server
LLAMA_BIND_ADDRESS=127.0.0.1
LLAMA_PORT=8000
LLAMA_ALIAS=qwen3.8-uncensored
LLAMA_CONTEXT_SIZE=16384
LLAMA_GPU_LAYERS=999
LLAMA_PARALLEL=1

LLAMA_MODEL_REPO=JonathanColetti/Qwen3.8-27B-Uncensored-GGUF
LLAMA_MODEL_FILENAME=Qwen3.8-27B-Uncensored-Q4_K_M.gguf
LLAMA_MODEL_DIR=/workspace/models/llm
AI_STACK_RUNTIME_DIR=/workspace/run/ai-phone-stack

# Optionnel. /run est volontairement hors du FUSE /workspace (qui force 0666).
LLAMA_API_KEY_FILE=/run/secrets/ai-phone-stack/llama_api_key
LLAMA_REQUIRE_API_KEY=0
