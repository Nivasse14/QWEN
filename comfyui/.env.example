# Copier vers .env. Ne jamais inscrire HF_TOKEN ni une clé Bearer ici.

COMFYUI_SOURCE_DIR=/workspace/ComfyUI
COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_REF=master
COMFYUI_VENV_DIR=/workspace/venvs/comfyui
COMFYUI_BIND_ADDRESS=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_VRAM_MODE=lowvram
AI_STACK_RUNTIME_DIR=/workspace/run/ai-phone-stack

COMFYUI_GGUF_REPO=https://github.com/city96/ComfyUI-GGUF.git
COMFYUI_GGUF_REF=main
FLUX_UNET_REPO=city96/FLUX.1-dev-gguf
FLUX_UNET_FILENAME=flux1-dev-Q5_K_S.gguf
FLUX_T5_REPO=city96/t5-v1_1-xxl-encoder-gguf
FLUX_T5_FILENAME=t5-v1_1-xxl-encoder-Q4_K_M.gguf
FLUX_CLIP_REPO=comfyanonymous/flux_text_encoders
FLUX_CLIP_FILENAME=clip_l.safetensors
FLUX_VAE_REPO=black-forest-labs/FLUX.1-dev
FLUX_VAE_FILENAME=ae.safetensors

# Orchestrateur OpenAI images local; secret facultatif, exclusivement sous /run.
FLUX_ORCHESTRATOR_BIND=127.0.0.1
FLUX_ORCHESTRATOR_PORT=8001
FLUX_ORCHESTRATOR_BASE_URL=http://127.0.0.1:8001
FLUX_ORCHESTRATOR_URL=http://127.0.0.1:8001/v1/images/generations
FLUX_ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:8001
FLUX_ORCHESTRATOR_API_KEY_FILE=/run/secrets/ai-phone-stack/flux_orchestrator_token
